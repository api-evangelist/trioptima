        {
          "id": "3c7cdba7-52aa-4805-aeba-0d4ac5da3e85",
          "name": "Submit Risk Data for Cycle",
          "request": {
            "name": "Submit Risk Data for Cycle",
            "description": {
              "content": "Submits risk constraints (delta ladders, DV01 limits) for a compression cycle. Risk data constrains the optimization algorithm to preserve the participant's aggregate risk profile within specified tolerances.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "cycles",
                ":cycleId",
                "risk"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "cycleId",
                  "description": "(Required) Unique identifier for the compression cycle"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
