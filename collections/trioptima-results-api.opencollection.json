{
  "opencollection": "1.0.0",
  "info": {
    "name": "Trioptima triReduce Cycles Results API",
    "version": "1"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://auth.trireduce.com/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Results",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Cycle Results",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://rates.trireduce.com/api/v1/cycles/:cycleId/results",
            "params": [
              {
                "name": "cycleId",
                "value": "",
                "type": "path",
                "description": "Unique identifier for the compression cycle"
              }
            ]
          },
          "docs": "Returns the compression results for a completed cycle, including the set of terminations and new replacement trades, notional reduction achieved, and summary statistics."
        },
        {
          "info": {
            "name": "Confirm Cycle Results",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://rates.trireduce.com/api/v1/cycles/:cycleId/results/confirm",
            "params": [
              {
                "name": "cycleId",
                "value": "",
                "type": "path",
                "description": "Unique identifier for the compression cycle"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Confirms the participant's acceptance of the compression results for a cycle. This is required before terminations and new trades are processed. All participants must confirm before the cycle settles."
        }
      ]
    }
  ],
  "bundled": true
}